#!/bin/bash
#
# yeet-run — one iteration, entirely inside the microVM.
#
# Staged into run state (NOT baked into the image) so iterating on it never means rebuilding
# a 563 MB image.
#
# Contract, in one line: this script writes FACTS, the host writes JSON. Every value in
# meta.kv matches ^[A-Za-z0-9._:/+=-]*$ — SHAs, integers, enum tokens. Free text goes in the
# raw .log files. The guest has no jq and no python3, so hand-rolled JSON escaping over
# arbitrary test output would be a guaranteed bug.
#
# The other invariant: **once DONE exists this script exits 0**, always. That makes any
# nonzero launcher exit unambiguously an infrastructure failure, which is what lets the host
# tell "the agent failed" (a result) from "the VM failed" (a retry).
#
# There are deliberately NO timeouts in here. Liveness is the CLI controller's call: it
# watches the shared mount for signs of life and (1) drops a STOP file to end the agent
# gracefully — budget hit, or wedged — then (2) kills the VM only if even that is ignored.
# A fuse inside the guest cannot know that a human is mid-answer on an ask_user question;
# the controller can.
#
# bash, not sh: /bin/sh is dash here, and this needs arrays and reliable pipefail.
set -uo pipefail

# YEET_DIR arrives via the launcher's --env (env values round-trip byte-exact; argv does not).
# Everything else comes from the per-iteration request file, so no state is shared between
# iterations via a fixed mutable path.
: "${YEET_DIR:?YEET_DIR must be set by the launcher}"
. "$YEET_DIR/request.env"

# /yeet/bin first: it holds this run's staged tools, and in the no-LLM roundtrip tests it
# holds a fake `pi`, which is what lets the whole machine be proven without spending a token.
export PATH="/yeet/bin:$PATH"

# The provider key lives in an agent-level 0600 file inside a 0700 dir, sourced but never
# echoed. It is deliberately not in request.env (which is per-iteration and gets read for
# debugging), not in argv (world-readable via ps), and not baked into the image.
[ -f /yeet/run.env ] && . /yeet/run.env

D="$YEET_DIR"
mkdir -p "$D"
# The runner's own trace goes to its own file — never mixed into agent.log or test.log, which
# are parsed and fed back to the model.
exec 2>"$D/runner.log"
set -x

W="$YEET_WORKSPACE"
cd "$W"

meta() { printf '%s=%s\n' "$1" "$2" >> "$D/meta.kv.tmp"; }

: > "$D/meta.kv.tmp"
meta schema      "yeet.meta/1"
meta runId       "$YEET_RUN_ID"
meta iteration   "$YEET_ITER"
meta phase       "$YEET_PHASE"
meta startedAtEpoch "$(date +%s)"

git config --global --add safe.directory '*' 2>/dev/null || true

# Keep build output out of the commit. The runner commits with `git add -A`, so without this a
# single `bun install` puts 500 files of node_modules on the branch — measured — which makes
# the diffstat meaningless, the branch unmergeable, and the tree SHA churn so much that
# no-progress detection can never fire. Asking for a coverage command made it worse by adding
# lcov.info to every run.
#
# .git/info/exclude, NOT .gitignore: this is yeet's opinion about its own sandbox, and it must
# not appear in the diff the user eventually merges.
mkdir -p .git/info 2>/dev/null || true
cat > .git/info/exclude <<'EXCLUDE'
node_modules/
.pnpm-store/
vendor/
target/
dist/
build/
.next/
__pycache__/
.pytest_cache/
.venv/
venv/
coverage/
.nyc_output/
lcov.info
.lcov.info.*
*.lcov
*.log
.DS_Store
EXCLUDE

BEFORE_HEAD=$(git rev-parse HEAD 2>/dev/null || echo "")
BEFORE_TREE=$(git rev-parse 'HEAD^{tree}' 2>/dev/null || echo "")
meta beforeHead "$BEFORE_HEAD"
meta beforeTree "$BEFORE_TREE"

# ── agent ───────────────────────────────────────────────────────────────────────────────
AGENT_EXIT=""
if [ "$YEET_RUN_AGENT" = "1" ]; then
  export PI_CODING_AGENT_SESSION_DIR="$YEET_SESSION_DIR"
  export PI_OFFLINE=1 PI_SKIP_VERSION_CHECK=1
  mkdir -p "$YEET_SESSION_DIR" "$D/qa"

  # Resume deterministically: pass -c only when a session file actually exists, rather than
  # relying on -c failing gracefully on an empty dir.
  RESUME=""
  if ls "$YEET_SESSION_DIR"/*.jsonl >/dev/null 2>&1 || \
     ls "$YEET_SESSION_DIR"/*/*.jsonl >/dev/null 2>&1; then
    RESUME="-c"
  fi
  meta sessionMode "$([ -n "$RESUME" ] && echo continue || echo new)"

  A0=$(date +%s)
  # stdin from /dev/null because pi -p otherwise blocks on the libkrun console device.
  # -e loads yeet's own tools (ask_user, set_verify) — see guest/yeet-tools.ts.
  # --mode json makes agent.log an NDJSON event stream rather than prose: tool_execution_start
  # / _update / _end, message_update carrying text deltas, turn boundaries, and — invisible to
  # yeet until now — auto_retry_* and compaction_*. Events are emitted AS THEY HAPPEN, which is
  # what makes a live trace possible and what actually fixes the empty-log problem.
  #
  # stdbuf -oL was the previous attempt at that and could not work: in text mode pi prints only
  # the final message, so there is nothing to line-buffer. Measured after the stdbuf fix landed,
  # an agent that made 78 tool calls with 66 errors over three minutes and was then SIGTERMed
  # still left a 0-byte log. The runs that get stopped are the expensive, confusing ones you
  # most need to read. Keep stdbuf anyway — it is what flushes each event line promptly.
  #
  # Redirect, never pipe: `pi ... | tee` discards pi's exit code (a pipeline's status is the
  # last command's, and tee always succeeds) — that is the spike's fabricated success signal.
  stdbuf -oL -eL \
    pi -p "$(cat "$D/prompt.txt")" --model "$YEET_MODEL" -a $RESUME --mode json \
    -e /yeet/bin/yeet-tools.ts \
    > "$D/agent.raw.jsonl" 2>&1 < /dev/null &
  PI_PID=$!

  # STOP watchdog. The controller drops a STOP file when the budget cap is crossed or the
  # guest has shown no signs of life. We do the killing rather than the host killing the VM,
  # because a VM kill would lose this iteration's commit entirely — whereas stopping pi lets
  # the runner continue normally: squash-commit the partial work, run the verifier, write
  # meta.kv and DONE. The file's content is the controller's reason; we only presence-check.
  # set +x in the subshell: with tracing on, this loop would write to runner.log every 2s,
  # which the controller's liveness watch would read as "signs of life" — a watchdog that
  # accidentally defeats stall detection by existing.
  ( set +x
    while kill -0 "$PI_PID" 2>/dev/null; do
      if [ -f "$D/STOP" ]; then
        # Graceful first, and give it room. SIGTERM lets pi finish the sentence it is writing,
        # flush, and close the session file cleanly; SIGKILL loses whatever was still in flight.
        # 15s rather than 3 because a model mid-token-stream needs longer than a shell script,
        # and the alternative — losing the log of an expensive run — is worse than waiting.
        kill -TERM "$PI_PID" 2>/dev/null
        for _ in $(seq 1 15); do
          kill -0 "$PI_PID" 2>/dev/null || break
          sleep 1
        done
        kill -KILL "$PI_PID" 2>/dev/null
        break
      fi
      sleep 2
    done ) &
  WATCHDOG_PID=$!

  wait "$PI_PID"
  AGENT_EXIT=$?
  kill "$WATCHDOG_PID" 2>/dev/null
  A1=$(date +%s)
  [ -f "$D/STOP" ] && meta stopRequested 1

  meta agentExit    "$AGENT_EXIT"
  meta agentSeconds "$((A1 - A0))"

  # Newest by mtime, matching the HOST's rule in src/session.ts exactly. This used to be
  # `find | head -1` — directory order, i.e. arbitrary — which agrees with the host only while
  # exactly one file exists. Two pickers that diverge on the second file means the meta.kv
  # record and the host's cost accounting can silently describe different sessions.
  SESSION_FILE=$(find "$YEET_SESSION_DIR" -name '*.jsonl' -type f -printf '%T@ %p\n' 2>/dev/null \
                 | sort -rn | head -1 | cut -d' ' -f2-)
  meta sessionFile "${SESSION_FILE:-}"
else
  meta agentRan 0
fi

# ── chat leaves no fingerprints ─────────────────────────────────────────────────────────
# `yeet ask` is a conversation, not a work order. Whatever the agent touched while thinking
# out loud gets discarded so a question can never mutate the workspace.
if [ "$YEET_PHASE" = "chat" ]; then
  git checkout -q -- . 2>/dev/null || true
  git clean -qfd 2>/dev/null || true
fi

# ── commit ──────────────────────────────────────────────────────────────────────────────
# One commit per iteration, and ONLY in the agent phase — chat discards above, and every other
# phase runs no agent. --soft keeps the tree byte-identical while collapsing any commits the
# agent made on its own, so "the agent committed even though we told it not to" is a non-event
# rather than a corrupted history. The one iteration that must NOT be collapsed is a merge,
# because there the shape of history IS the result.
COMMITTED=0
DIVERGED=0
if [ "$YEET_PHASE" = "agent" ] && [ -n "$BEFORE_HEAD" ]; then
  if ! git merge-base --is-ancestor "$BEFORE_HEAD" HEAD 2>/dev/null; then
    # The agent did something exotic (checkout, hard reset). Committing on top preserves the
    # work; destroying it to force our shape would not.
    DIVERGED=1
  elif [ -n "$(git rev-list --min-parents=2 -n 1 "$BEFORE_HEAD..HEAD" 2>/dev/null)" ]; then
    # The agent merged a branch in, and a --soft reset would keep the resulting FILES while
    # discarding the merge commit's second parent. The merged branch then stops being an
    # ancestor, so git recomputes the merge from the original base and reports the IDENTICAL
    # conflict next time — resolving it can never stick, however many times you hand it back.
    # Ancestry beats tidiness: leave the agent's history exactly as it made it.
    COMMITTED=1
  else
    git reset --soft "$BEFORE_HEAD"
  fi
  git add -A
  if ! git diff --cached --quiet; then
    if git commit -q -F "$D/commit-msg.txt"; then COMMITTED=1; else meta gitError 1; fi
  fi
fi
meta committed        "$COMMITTED"
meta historyDiverged  "$DIVERGED"

AFTER_HEAD=$(git rev-parse HEAD 2>/dev/null || echo "")
AFTER_TREE=$(git rev-parse 'HEAD^{tree}' 2>/dev/null || echo "")
meta afterHead "$AFTER_HEAD"
meta afterTree "$AFTER_TREE"
# Tree SHA, not the diff: git's own content hash of the whole worktree, exact and free. This
# is the no-progress detector, and it only works because run artifacts live at /yeet/iter-NNN
# rather than inside the workspace.
meta treeChanged "$([ "$BEFORE_TREE" != "$AFTER_TREE" ] && echo 1 || echo 0)"

git diff --name-only -z "$BEFORE_HEAD" HEAD > "$D/changed.z" 2>/dev/null || : > "$D/changed.z"
git diff --shortstat "$BEFORE_HEAD" HEAD > "$D/diffstat.txt" 2>/dev/null || : > "$D/diffstat.txt"

# ── verify ──────────────────────────────────────────────────────────────────────────────
# In the coverage phase, test-cmd.sh holds the coverage command — same slot, same rules.
# No timeout: a hung verify shows up to the controller as test.log going quiet, and killing
# the VM at that point loses nothing (the commit above is already durable on the mount).
if [ "$YEET_RUN_TEST" = "1" ] && [ -f "$D/test-cmd.sh" ]; then
  T0=$(date +%s)
  # Redirect (not pipe) for the exit code, and </dev/null so a runner that reads stdin cannot
  # block on the console device forever.
  bash "$D/test-cmd.sh" > "$D/test.log" 2>&1 < /dev/null
  TEST_EXIT=$?
  T1=$(date +%s)
  meta testExit     "$TEST_EXIT"
  meta testSeconds  "$((T1 - T0))"
  meta testLogSha256 "$(sha256sum "$D/test.log" 2>/dev/null | cut -c1-16)"
  meta testLogBytes  "$(wc -c < "$D/test.log" | tr -d ' ')"
else
  meta testRan 0
fi

git status --porcelain -z > "$D/status.z" 2>/dev/null || : > "$D/status.z"
meta endedAtEpoch "$(date +%s)"

# ── publish ─────────────────────────────────────────────────────────────────────────────
# Compact the event stream, LAST — after the verifier has run and immediately before DONE.
# The host tails agent.raw.jsonl for the live trace, and deleting it the moment pi exits cut
# the stream off mid-sentence; leaving it until here gives the host the whole test phase to
# finish draining. DONE still comes after, so the sentinel stays the last thing written.
#
# Why compact at all: every message_update carries the whole partial message alongside its
# delta, so streaming one reply costs O(n²) bytes. Measured on one short iteration — 2414 KiB
# of log, of which 2296 KiB was 468 message_update lines growing from 892 B to 20 KB apiece,
# against a 31 KiB session JSONL for the same run.
#
# Those events matter only while they are arriving. Afterwards nothing reads them again: the
# final text is in message_end and the whole transcript is in agent_end. Dropping them leaves
# 4% of the bytes and loses nothing recoverable.
#
# grep, because the guest has no jq: "type" is always the first key, verified across every
# event kind pi emits. The `|| :` is load-bearing — grep exits 1 when it matches nothing (an
# agent killed before its first event), and this script runs under set -o pipefail.
if [ -f "$D/agent.raw.jsonl" ]; then
  grep -v '^{"type":"message_update"' "$D/agent.raw.jsonl" > "$D/agent.log" 2>/dev/null || :
  meta agentLogRawBytes "$(wc -c < "$D/agent.raw.jsonl" | tr -d ' ')"
  rm -f "$D/agent.raw.jsonl"
fi
meta agentLogBytes "$(wc -c < "$D/agent.log" 2>/dev/null | tr -d ' ' || echo 0)"

# Atomic renames within one filesystem, meta before DONE, so the host never observes a
# half-written result. DONE is the host's validity check.
sync
mv "$D/meta.kv.tmp" "$D/meta.kv"
sync

: > "$D/DONE.tmp"
mv "$D/DONE.tmp" "$D/DONE"
sync

exit 0
